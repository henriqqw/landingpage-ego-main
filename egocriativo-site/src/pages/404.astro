---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Icon from '../components/ui/Icon.astro';
import { site, waLink } from '../content/site';
---
<BaseLayout title={`Página não encontrada — ${site.name}`} noindex>
  <main class="flex min-h-screen items-center py-24">
    <Container class="text-center">
      <p class="mono-label text-orange">Erro 404</p>
      <h1 class="mt-4 text-[clamp(2rem,5vw,3.4rem)] leading-tight">
        Esta página não existe — <span class="text-gradient">mas o diagnóstico existe</span>.
      </h1>
      <p class="mx-auto mt-5 max-w-[520px] text-lg text-muted">
        O endereço que você tentou abrir não está aqui. Volte para o início ou fale com a gente.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a
          href="/"
          class="inline-flex items-center gap-2 rounded-full bg-orange px-6 py-3.5 text-sm font-semibold text-[#160b04] transition hover:bg-orange-600"
        >
          Voltar para o início <Icon name="arrow" size={18} />
        </a>
        <a
          href={waLink('Olá! Caí numa página que não existe no site.')}
          class="inline-flex items-center gap-2 rounded-full border border-line px-6 py-3.5 text-sm font-semibold text-ink transition hover:border-amber"
        >
          <Icon name="phone" size={18} /> Falar no WhatsApp
        </a>
      </div>
    </Container>
  </main>
</BaseLayout>
