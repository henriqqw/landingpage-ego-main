---
import { site } from '../../content/site';
import Container from '../ui/Container.astro';
---
<header class="absolute inset-x-0 top-0 z-30">
  <Container class="flex items-center justify-between py-6">
    <a href="#top" class="font-logo text-3xl leading-none text-ink" aria-label={site.name}>
      egocriativo
    </a>

    <nav class="hidden items-center gap-1 rounded-full glass p-1.5 md:flex">
      {
        site.nav.map((n) => (
          <a
            href={n.href}
            class="rounded-full px-4 py-2 text-sm text-ink/80 transition-colors hover:text-ink"
          >
            {n.label}
          </a>
        ))
      }
      <a
        href="#contato"
        class="ml-1 rounded-full bg-white px-4 py-2 text-sm font-semibold text-[#161310] transition-colors hover:bg-white/90"
      >
        Diagnóstico grátis
      </a>
    </nav>

    <a
      href="#contato"
      class="rounded-full glass px-4 py-2 text-sm font-medium text-ink md:hidden"
    >
      Diagnóstico
    </a>
  </Container>
</header>
