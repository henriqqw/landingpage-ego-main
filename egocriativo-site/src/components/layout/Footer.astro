---
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import { Image } from 'astro:assets';
// Importado de src/assets (e não de public/) para o Astro redimensionar e converter:
// o original tem 2779px e 190 KB para ser exibido a 52px.
import icone from '../../assets/icone.png';
import { site, waLink } from '../../content/site';
import { consultaCnpj } from '../../content/prova';
const year = new Date().getFullYear();
---
<footer class="border-t border-line py-14">
  <Container>
    <div class="flex flex-col gap-10 md:flex-row md:justify-between">
      <div class="max-w-sm">
        <div class="font-logo text-3xl text-ink">egocriativo</div>
        <p class="mt-3 text-muted">{site.tagline}</p>
      </div>
      <div class="flex flex-wrap gap-12">
        <div>
          <p class="mb-3 text-sm font-semibold text-ink">Navegação</p>
          <ul class="space-y-2 text-sm text-muted">
            {site.nav.map((n) => (
              <li><a href={n.href} class="hover:text-ink">{n.label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <p class="mb-3 text-sm font-semibold text-ink">Contato</p>
          <ul class="space-y-2 text-sm text-muted">
            <li>
              <a
                href={waLink('Olá! Vim pelo site da Ego Criativo.')}
                class="hover:text-ink"
                data-track="cta_click"
                data-track-id="footer-whatsapp">WhatsApp</a
              >
            </li>
            <li>{site.contact.phone}</li>
            <li><a href={`mailto:${site.contact.email}`} class="hover:text-ink">{site.contact.email}</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-4 border-t border-line pt-6 text-sm text-dim sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-4">
        <Image src={icone} alt="" class="marca" widths={[152, 304]} sizes="76px" loading="lazy" />
        <span>
          {site.legalName} ·{' '}
          <a
            href={consultaCnpj}
            target="_blank"
            rel="noopener noreferrer"
            class="text-muted underline decoration-dotted underline-offset-4 hover:text-amber"
            data-track="proof_click"
            data-track-id="footer-cnpj">CNPJ {site.cnpj} ↗</a
          >
          <span class="mono-label mt-1 block">
            CNAE principal 73.11-4-00 — Agências de publicidade
          </span>
        </span>
      </div>
      <div class="flex items-center gap-4">
        {site.social.linkedin && (
          <a href={site.social.linkedin} aria-label="LinkedIn" class="hover:text-ink">
            <Icon name="linkedin" size={18} />
          </a>
        )}
        {site.social.instagram && (
          <a href={site.social.instagram} aria-label="Instagram" class="hover:text-ink">
            <Icon name="instagram" size={18} />
          </a>
        )}
        <span>© {year} · Atendimento em todo o Brasil</span>
      </div>
    </div>
  </Container>
</footer>

<style>
  /* A marca é marrom sobre um rodapé quase-preto: sem um leve clareamento
     ela some. O brilho devolve presença sem alterar a cor da identidade. */
  .marca {
    width: 76px;
    height: auto;
    flex: none;
    /* O PNG traz uma sombra elíptica embaixo do símbolo, o que joga o centro
       óptico para cima. O deslocamento devolve o alinhamento com o texto. */
    margin-top: -6px;
    filter: brightness(1.45) saturate(1.1);
  }
</style>
