// Ícones sólidos precisam de fill em vez de stroke.
const solidos = new Set(['whatsapp']);
const solido = solidos.has(name);
const d = paths[name] ?? '';
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={solido ? 'currentColor' : 'none'}
  stroke={solido ? 'none' : 'currentColor'}
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={klass}
  aria-hidden="true"
  set:html={d}
/>
