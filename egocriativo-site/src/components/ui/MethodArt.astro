---
// Gêmeo do PainArt, mesma gramática (cinza + um acento laranja) — mas aqui o laranja
// resolve em vez de acusar. Quatro cenas, uma por etapa do método:
//   diagnostico — a busca da seção de Dores, que não achava nada, agora acha
//   plano       — prancheta com meta, cronograma e indicador validados e aprovados
//   execucao    — documento → engrenagem → site no ar
//   resultado   — painel de KPIs: o que cai é pausado, o que cresce é aprovado
interface Props {
  name: string;
}
const { name } = Astro.props;

// execução: dentes da engrenagem, distribuídos a cada 45°
const dentes = Array.from({ length: 8 }, (_, i) => i * 45);
---
{
  name === 'diagnostico' && (
    <svg viewBox="0 0 320 180" class="art" fill="none" aria-hidden="true">
      {/* a mesma barra de busca da cena "seo" — agora com resposta */}
      <rect x="20" y="14" width="200" height="30" rx="15" class="s-line" stroke-width="1.5" />
      <circle cx="40" cy="28" r="5.5" class="s-mid" stroke-width="1.5" />
      <line x1="44" y1="32" x2="48.5" y2="36.5" class="s-mid" stroke-width="1.5" stroke-linecap="round" />
      <rect class="consulta" x="60" y="26" width="120" height="5" rx="2.5" />

      <g class="rows">
        <rect x="76" y="64" width="82" height="6" rx="3" />
        <rect class="sub" x="76" y="75" width="118" height="4" rx="2" />
        <rect class="hit" x="76" y="100" width="94" height="6" rx="3" />
        <rect class="sub" x="76" y="111" width="126" height="4" rx="2" />
        <rect x="76" y="136" width="70" height="6" rx="3" />
        <rect class="sub" x="76" y="147" width="104" height="4" rx="2" />
      </g>

      {/* a lupa desce uma vez e PARA no resultado certo */}
      <g class="lens-stop">
        <circle cx="46" cy="70" r="14" class="s-mid" stroke-width="1.8" />
        <line x1="56" y1="80" x2="62.5" y2="86.5" class="s-mid" stroke-width="2" stroke-linecap="round" />
        <path class="check" d="M40 70 l4.5 4.5 L53 66" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
      </g>

      {/* e os números aparecem do lado */}
      <g class="vals">
        <rect x="238" y="62" width="58" height="5" rx="2.5" />
        <rect x="238" y="98" width="44" height="5" rx="2.5" />
        <rect x="238" y="134" width="52" height="5" rx="2.5" />
      </g>
    </svg>
  )
}
{
  name === 'plano' && (
    <svg viewBox="0 0 320 180" class="art" fill="none" aria-hidden="true">
      {/* A prancheta: o plano como documento. Meta, cronograma e indicador são
          validados um a um; depois a aprovação é dada e o plano ganha o check. */}
      <rect x="52" y="20" width="150" height="140" rx="8" class="s-line" stroke-width="1.6" />
      <rect x="104" y="12" width="46" height="16" rx="5" class="s-mid" stroke-width="1.6" />

      <g class="itens">
        {/* 1 — meta (alvo) */}
        <circle cx="78" cy="60" r="9" class="s-mid" stroke-width="1.4" />
        <circle cx="78" cy="60" r="4.5" class="s-mid" stroke-width="1.2" />
        <circle cx="78" cy="60" r="1.7" class="ponto" />
        <rect class="linha" x="98" y="57.5" width="50" height="5" rx="2.5" />
        <rect x="160" y="52" width="16" height="16" rx="4" class="s-line caixa" stroke-width="1.4" />

        {/* 2 — cronograma (calendário) */}
        <rect x="69" y="89" width="18" height="15" rx="2" class="s-mid" stroke-width="1.4" />
        <line x1="69" y1="94" x2="87" y2="94" class="s-mid" stroke-width="1.2" />
        <line x1="74" y1="86" x2="74" y2="90" class="s-mid" stroke-width="1.2" stroke-linecap="round" />
        <line x1="82" y1="86" x2="82" y2="90" class="s-mid" stroke-width="1.2" stroke-linecap="round" />
        <rect class="linha" x="98" y="93.5" width="42" height="5" rx="2.5" />
        <rect x="160" y="88" width="16" height="16" rx="4" class="s-line caixa" stroke-width="1.4" />

        {/* 3 — indicador (gráfico) */}
        <rect class="barra" x="69" y="132" width="4.5" height="8" rx="1" />
        <rect class="barra" x="76" y="127" width="4.5" height="13" rx="1" />
        <rect class="barra alta" x="83" y="121" width="4.5" height="19" rx="1" />
        <rect class="linha" x="98" y="129.5" width="46" height="5" rx="2.5" />
        <rect x="160" y="124" width="16" height="16" rx="4" class="s-line caixa" stroke-width="1.4" />
      </g>

      {/* os checks entram um após o outro */}
      <path class="tick t1" d="M163.5 60 l3.5 3.5 l6 -7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      <path class="tick t2" d="M163.5 96 l3.5 3.5 l6 -7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      <path class="tick t3" d="M163.5 132 l3.5 3.5 l6 -7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />

      {/* e o plano inteiro recebe o check */}
      <path
        class="check-plano"
        d="M96 92 l20 21 l42 -48"
        stroke-width="6"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  )
}
{
  name === 'execucao' && (
    <svg viewBox="0 0 320 180" class="art" fill="none" aria-hidden="true">
      {/* Do plano ao ar: documento → engrenagem → site publicado.
          Um ponto laranja percorre a linha; ao chegar na engrenagem, ela gira. */}

      {/* trilho entre as três etapas */}
      <line x1="74" y1="84" x2="141" y2="84" class="s-faint" stroke-width="1.4" stroke-dasharray="4 5" />
      <line x1="179" y1="84" x2="208" y2="84" class="s-faint" stroke-width="1.4" stroke-dasharray="4 5" />

      {/* 1 — documento (planejamento) */}
      <g>
        <rect x="32" y="60" width="38" height="48" rx="3" class="s-mid" stroke-width="1.5" />
        <rect class="doc-linha" x="39" y="70" width="24" height="3.4" rx="1.7" />
        <rect class="doc-linha" x="39" y="79" width="19" height="3.4" rx="1.7" />
        <rect class="doc-linha" x="39" y="88" width="24" height="3.4" rx="1.7" />
        <rect class="doc-linha" x="39" y="97" width="14" height="3.4" rx="1.7" />
      </g>

      {/* 2 — engrenagem (implementação) */}
      <g class="engrenagem">
        {dentes.map((a) => (
          <rect
            x="158"
            y="60"
            width="4"
            height="7.5"
            rx="1"
            class="s-mid"
            stroke-width="1.2"
            transform={`rotate(${a} 160 84)`}
          />
        ))}
        <circle cx="160" cy="84" r="17" class="s-mid" stroke-width="1.5" />
        <circle cx="160" cy="84" r="6.5" class="s-line" stroke-width="1.4" />
      </g>

      {/* 3 — navegador (site no ar) */}
      <g>
        <rect x="210" y="56" width="82" height="56" rx="4" class="s-mid" stroke-width="1.5" />
        <line x1="210" y1="69" x2="292" y2="69" class="s-line" stroke-width="1.3" />
        <circle cx="218" cy="62.5" r="1.7" class="s-line" stroke-width="1.1" />
        <circle cx="225" cy="62.5" r="1.7" class="s-line" stroke-width="1.1" />
        <circle cx="232" cy="62.5" r="1.7" class="s-line" stroke-width="1.1" />
        <g class="site">
          <rect class="doc-linha" x="219" y="79" width="40" height="4" rx="2" />
          <rect class="doc-linha" x="219" y="89" width="64" height="3.4" rx="1.7" />
          <rect class="doc-linha" x="219" y="98" width="52" height="3.4" rx="1.7" />
        </g>
      </g>

      {/* o ponto que percorre o trilho */}
      <circle class="ponto-fluxo" cx="0" cy="84" r="3.4" />

      {/* e o site entra no ar */}
      <path
        class="check-site"
        d="M232 86 l9 10 l21 -24"
        stroke-width="5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  )
}
{
  name === 'resultado' && (
    <svg viewBox="0 0 320 180" class="art" fill="none" aria-hidden="true">
      {/* Três barras baixas e irregulares. O marcador laranja percorre o gráfico e,
          ao passar por cada uma, ela cresce — até virar progressão. No fim, a linha
          liga os topos e termina em seta. */}

      {/* eixo */}
      <line x1="56" y1="142" x2="252" y2="142" class="s-line" stroke-width="1.5" stroke-linecap="round" />

      {/* barras: ficam na altura final e sobem por scaleY */}
      <rect class="barra b1" x="70" y="102" width="36" height="40" rx="3" />
      <rect class="barra b2" x="134" y="76" width="36" height="66" rx="3" />
      <rect class="barra b3" x="198" y="46" width="36" height="96" rx="3" />

      {/* linha que liga os topos, desenhada no fim.
          A ponta sai da terceira barra em ângulo aberto, para não raspar nela. */}
      <g class="progressao">
        <path
          class="linha-topos"
          d="M88 102 L152 76 L216 46 L252 22"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          class="ponta"
          d="M245.4 33.7 L252 22 L238.7 23.7"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </g>
      <g class="vertices">
        <circle cx="88" cy="102" r="3" />
        <circle cx="152" cy="76" r="3" />
        <circle cx="216" cy="46" r="3" />
      </g>

      {/* o marcador que percorre o gráfico */}
      <g class="marcador">
        <line x1="0" y1="150" x2="0" y2="136" stroke-width="1.6" stroke-linecap="round" />
        <circle cx="0" cy="152" r="3.6" />
      </g>
    </svg>
  )
}

<style>
  .art {
    /* Tinta e acento parametrizados: a mesma arte serve no fundo escuro e no claro.
       Quem troca é a seção, definindo --art-ink e --art-acento no contêiner. */
    --ink: var(--art-ink, 255, 255, 255);
    --acento: var(--art-acento, #f0742a);
    /* Reforço de opacidade dos traços (1 no escuro, ~2 no claro). */
    --art-boost: var(--art-contraste, 1);
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }
  .s-faint { stroke: rgba(var(--ink), calc(0.12 * var(--art-boost, 1))); }
  .s-line { stroke: rgba(var(--ink), calc(0.2 * var(--art-boost, 1))); }
  .s-mid { stroke: rgba(var(--ink), calc(0.36 * var(--art-boost, 1))); }
  .label {
    fill: rgba(var(--ink), calc(0.3 * var(--art-boost, 1)));
    font-family: var(--font-mono);
    letter-spacing: 0.12em;
  }

  /* ---- 01 diagnóstico: a busca que não achava, acha ---- */
  .consulta { fill: rgba(var(--ink), calc(0.16 * var(--art-boost, 1))); }
  .rows rect { fill: rgba(var(--ink), calc(0.17 * var(--art-boost, 1))); }
  .rows .sub { fill: rgba(var(--ink), calc(0.08 * var(--art-boost, 1))); }
  .rows .hit {
    fill: var(--acento);
    animation: hit-on 5.5s ease-in-out infinite;
  }
  @keyframes hit-on {
    0%, 28% { fill: rgba(var(--ink), calc(0.17 * var(--art-boost, 1))); }
    38%, 88% { fill: var(--acento); }
    100% { fill: rgba(var(--ink), calc(0.17 * var(--art-boost, 1))); }
  }
  .lens-stop { animation: lens-down 5.5s cubic-bezier(0.6, 0, 0.35, 1) infinite; }
  @keyframes lens-down {
    0%, 12% { transform: translateY(0); }
    32%, 90% { transform: translateY(36px); }
    100% { transform: translateY(0); }
  }
  .check {
    stroke: var(--acento);
    animation: check-in 5.5s ease-out infinite;
  }
  @keyframes check-in {
    0%, 34% { opacity: 0; }
    44%, 88% { opacity: 1; }
    100% { opacity: 0; }
  }
  .vals rect {
    fill: rgba(var(--ink), calc(0.22 * var(--art-boost, 1)));
    transform-box: fill-box;
    transform-origin: left center;
    animation: val-in 5.5s ease-out infinite;
  }
  .vals rect:nth-child(2) { animation-delay: 0.14s; }
  .vals rect:nth-child(3) { animation-delay: 0.28s; }
  @keyframes val-in {
    0%, 40% { transform: scaleX(0); }
    52%, 90% { transform: scaleX(1); }
    100% { transform: scaleX(0); }
  }

  /* ---- 02 plano: os três itens são validados, o plano é aprovado ----
     Ciclo de 8s: check da meta → do cronograma → do indicador → botão pressionado
     → check grande sobre a prancheta. */
  .ponto {
    fill: var(--acento);
  }
  .linha {
    fill: rgba(var(--ink), calc(0.16 * var(--art-boost, 1)));
  }
  .barra {
    fill: rgba(var(--ink), calc(0.3 * var(--art-boost, 1)));
  }
  .barra.alta {
    fill: var(--acento);
  }
  /* Os itens recuam quando o check final entra, para ele ficar em destaque. */
  .itens {
    animation: itens-recuam 8s ease-in-out infinite;
  }
  @keyframes itens-recuam {
    0%, 52% { opacity: 1; }
    62%, 90% { opacity: 0.28; }
    96%, 100% { opacity: 1; }
  }

  .tick {
    stroke: var(--acento);
    transform-box: fill-box;
    transform-origin: center;
  }
  .t1 { animation: tick-in 8s cubic-bezier(0.2, 1, 0.3, 1) infinite; }
  .t2 { animation: tick-in 8s cubic-bezier(0.2, 1, 0.3, 1) infinite 0.9s; }
  .t3 { animation: tick-in 8s cubic-bezier(0.2, 1, 0.3, 1) infinite 1.8s; }
  @keyframes tick-in {
    0%, 6% { opacity: 0; transform: scale(0.5); }
    12%, 84% { opacity: 1; transform: scale(1); }
    90%, 100% { opacity: 0; transform: scale(0.5); }
  }

  /* O check do plano é desenhado, não aparece de uma vez. */
  .check-plano {
    stroke: var(--acento);
    stroke-dasharray: 96;
    stroke-dashoffset: 96;
    animation: check-plano-draw 8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }
  @keyframes check-plano-draw {
    0%, 50% { stroke-dashoffset: 96; opacity: 0; }
    52% { opacity: 1; }
    66%, 88% { stroke-dashoffset: 0; opacity: 1; }
    94%, 100% { stroke-dashoffset: 96; opacity: 0; }
  }

  /* ---- 03 execução: do plano ao site no ar ----
     Ciclo de 8s: o ponto sai do documento → chega na engrenagem, que gira →
     segue para o navegador → o site aparece e recebe o check. */
  .doc-linha {
    fill: rgba(var(--ink), calc(0.22 * var(--art-boost, 1)));
  }

  .ponto-fluxo {
    fill: var(--acento);
    animation: ponto-anda 8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }
  @keyframes ponto-anda {
    0%, 4% { transform: translateX(74px); opacity: 0; }
    8% { transform: translateX(74px); opacity: 1; }
    26%, 36% { transform: translateX(141px); opacity: 1; }
    /* atravessa a engrenagem sem aparecer por cima dela */
    38%, 44% { transform: translateX(160px); opacity: 0; }
    48% { transform: translateX(179px); opacity: 1; }
    62%, 70% { transform: translateX(208px); opacity: 1; }
    76%, 100% { transform: translateX(208px); opacity: 0; }
  }

  /* Só gira enquanto o ponto está nela. */
  .engrenagem {
    transform-box: fill-box;
    transform-origin: center;
    animation: engrena 8s cubic-bezier(0.5, 0, 0.5, 1) infinite;
  }
  @keyframes engrena {
    0%, 30% { transform: rotate(0deg); }
    56%, 100% { transform: rotate(135deg); }
  }

  /* O site sobe depois que a engrenagem trabalha. */
  .site rect {
    transform-box: fill-box;
    transform-origin: left center;
    animation: site-sobe 8s ease-out infinite;
  }
  .site rect:nth-child(2) { animation-delay: 0.12s; }
  .site rect:nth-child(3) { animation-delay: 0.24s; }
  @keyframes site-sobe {
    0%, 60% { transform: scaleX(0); opacity: 0; }
    68%, 74% { transform: scaleX(1); opacity: 1; }
    80%, 92% { transform: scaleX(1); opacity: 0.25; }
    98%, 100% { transform: scaleX(0); opacity: 0; }
  }

  .check-site {
    stroke: var(--acento);
    stroke-dasharray: 52;
    stroke-dashoffset: 52;
    animation: check-site-draw 8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }
  @keyframes check-site-draw {
    0%, 74% { stroke-dashoffset: 52; opacity: 0; }
    76% { opacity: 1; }
    86%, 94% { stroke-dashoffset: 0; opacity: 1; }
    98%, 100% { stroke-dashoffset: 52; opacity: 0; }
  }

  /* ---- 04 resultado: o marcador percorre e as barras crescem ----
     Ciclo de 7s: barras baixas e irregulares → o marcador passa por cada uma e ela
     sobe → a linha liga os topos e termina em seta → pausa → recomeça. */
  .barra {
    fill: rgba(var(--ink), calc(0.28 * var(--art-boost, 1)));
    transform-box: fill-box;
    transform-origin: bottom;
  }
  /* Cada barra parte de uma altura diferente: é o "irregular" do início. */
  .b1 { animation: sobe-1 7s cubic-bezier(0.2, 1, 0.3, 1) infinite; }
  .b2 { animation: sobe-2 7s cubic-bezier(0.2, 1, 0.3, 1) infinite; }
  .b3 { animation: sobe-3 7s cubic-bezier(0.2, 1, 0.3, 1) infinite; }
  @keyframes sobe-1 {
    0%, 18% { transform: scaleY(0.55); }
    28%, 92% { transform: scaleY(1); }
    98%, 100% { transform: scaleY(0.55); }
  }
  @keyframes sobe-2 {
    0%, 34% { transform: scaleY(0.21); }
    44%, 92% { transform: scaleY(1); }
    98%, 100% { transform: scaleY(0.21); }
  }
  @keyframes sobe-3 {
    0%, 50% { transform: scaleY(0.27); }
    60%, 92% { transform: scaleY(1); }
    98%, 100% { transform: scaleY(0.27); }
  }
  /* A que fecha a progressão recebe o acento. */
  .b3 {
    fill: var(--acento);
  }

  .marcador line {
    stroke: var(--acento);
  }
  .marcador circle {
    fill: var(--acento);
  }
  .marcador {
    animation: marcador-anda 7s cubic-bezier(0.45, 0, 0.35, 1) infinite;
  }
  @keyframes marcador-anda {
    0%, 6% { transform: translateX(56px); opacity: 0; }
    10% { transform: translateX(60px); opacity: 1; }
    22%, 30% { transform: translateX(88px); opacity: 1; }
    40%, 46% { transform: translateX(152px); opacity: 1; }
    56%, 62% { transform: translateX(216px); opacity: 1; }
    70% { transform: translateX(250px); opacity: 0; }
    100% { transform: translateX(250px); opacity: 0; }
  }

  /* Os topos aparecem e a linha os liga. */
  .vertices circle {
    fill: var(--acento);
    animation: vertice-in 7s ease-out infinite;
  }
  .vertices circle:nth-child(2) { animation-delay: 0.18s; }
  .vertices circle:nth-child(3) { animation-delay: 0.36s; }
  @keyframes vertice-in {
    0%, 66% { opacity: 0; }
    72%, 92% { opacity: 1; }
    98%, 100% { opacity: 0; }
  }
  .progressao path {
    stroke: var(--acento);
  }
  .progressao .linha-topos {
    stroke-dasharray: 190;
    stroke-dashoffset: 190;
    animation: liga-topos 7s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }
  @keyframes liga-topos {
    0%, 68% { stroke-dashoffset: 190; opacity: 0; }
    70% { opacity: 1; }
    84%, 92% { stroke-dashoffset: 0; opacity: 1; }
    97%, 100% { stroke-dashoffset: 190; opacity: 0; }
  }
  /* A ponta precisa dos próprios keyframes: com o dasharray dela (26), reaproveitar
     o offset da linha (190) faria o tracejado dar várias voltas e a seta piscar. */
  .progressao .ponta {
    stroke-dasharray: 26;
    stroke-dashoffset: 26;
    animation: desenha-ponta 7s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }
  @keyframes desenha-ponta {
    0%, 82% { stroke-dashoffset: 26; opacity: 0; }
    84% { opacity: 1; }
    90%, 92% { stroke-dashoffset: 0; opacity: 1; }
    97%, 100% { stroke-dashoffset: 26; opacity: 0; }
  }
</style>
