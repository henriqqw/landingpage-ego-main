---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  class?: string;
  [key: string]: any;
}
const { href = '#', variant = 'primary', class: klass = '', ...rest } = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-full px-6 py-3.5 text-sm font-semibold transition-transform duration-200 hover:-translate-y-0.5 focus-visible:-translate-y-0.5';
const variants: Record<string, string> = {
  primary: 'bg-orange text-[#160b04] hover:bg-orange-600',
  secondary: 'glass text-ink hover:border-amber',
  ghost: 'text-ink/90 hover:text-ink',
};
---
<a href={href} class={`${base} ${variants[variant]} ${klass}`} {...rest}>
  <slot />
</a>
