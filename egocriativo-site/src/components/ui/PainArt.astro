---
// Artes da seção de Dores. Grayscale com fades suaves + um único ponto laranja
// marcando exatamente o problema. Emblemas (200x140) nos cards de cima,
// painéis largos (320x180) nos dois cards de baixo.
interface Props {
  name: string;
}
const { name } = Astro.props;

// social: slots do feed no celular
const feed = [24, 58, 92];

// brand: prateleira de marcas indistinguíveis (a 3ª é a "sua")
const shelf = [12, 58, 104, 150].map((x, i) => ({ x, i, you: i === 2 }));
---
{
  name === 'seo' && (
    <svg viewBox="0 0 200 140" class="art" fill="none" aria-hidden="true">
      {/* barra de pesquisa: a consulta sendo digitada */}
      <rect x="16" y="8" width="168" height="32" rx="16" class="s-line" stroke-width="1.5" />
      <circle cx="36" cy="23" r="5.5" class="s-mid" stroke-width="1.5" />
      <line x1="40" y1="27" x2="44.5" y2="31.5" class="s-mid" stroke-width="1.5" stroke-linecap="round" />
      <rect class="typed" x="56" y="21" width="92" height="6" rx="3" />
      <line class="caret" x1="152" y1="15" x2="152" y2="33" stroke-width="1.5" stroke-linecap="round" />

      {/* lista de resultados */}
      <g class="rows">
        <rect x="74" y="55" width="60" height="6" rx="3" />
        <rect class="sub" x="74" y="66" width="96" height="4" rx="2" />
        <rect x="74" y="83" width="52" height="6" rx="3" />
        <rect class="sub" x="74" y="94" width="88" height="4" rx="2" />
        <rect x="74" y="111" width="64" height="6" rx="3" />
        <rect class="sub" x="74" y="122" width="80" height="4" rx="2" />
      </g>

      {/* a lupa percorre a lista — e só encontra interrogação */}
      <g class="lens">
        <circle cx="44" cy="61" r="14" class="s-mid" stroke-width="1.8" />
        <line x1="54" y1="71" x2="60.5" y2="77.5" class="s-mid" stroke-width="2" stroke-linecap="round" />
        <text class="found" x="44" y="67" text-anchor="middle" font-size="17">?</text>
      </g>
    </svg>
  )
}
{
  name === 'brand' && (
    <svg viewBox="0 0 200 140" class="art" fill="none" aria-hidden="true">
      {/* prateleira: todas as marcas na mesma caixa, do mesmo tamanho */}
      {shelf.map((t) => (
        <g style={`--d:${t.i * 0.34}s`}>
          <rect
            x={t.x}
            y="42"
            width="38"
            height="40"
            rx="10"
            class={t.you ? 's-you' : 's-line'}
            stroke-width="1.5"
          />
          <g class="mark">
            <circle cx={t.x + 19} cy="57" r="6.5" stroke-width="1.5" class={t.you ? 's-you' : 's-mid'} />
            <rect
              x={t.x + 9}
              y="69"
              width="20"
              height="3.5"
              rx="1.75"
              class={t.you ? 'f-you' : 'f-name'}
            />
          </g>
        </g>
      ))}
      <line x1="8" y1="94" x2="192" y2="94" class="s-faint" stroke-width="1.4" />
    </svg>
  )
}
{
  name === 'social' && (
    <svg viewBox="0 0 200 140" class="art" fill="none" aria-hidden="true">
      <defs>
        <clipPath id="phone-screen">
          <rect x="60" y="18" width="80" height="110" rx="10" />
        </clipPath>
      </defs>

      {/* smartphone */}
      <rect x="54" y="4" width="92" height="132" rx="16" class="s-line" stroke-width="1.6" />
      <rect x="87" y="10" width="26" height="4" rx="2" class="f-name" />

      {/* feed: posts entram, ganham métricas zeradas e somem */}
      <g clip-path="url(#phone-screen)">
        {feed.map((y, i) => (
          <g class="post" style={`--d:${i * 0.55}s`}>
            <rect x="66" y={y} width="64" height="30" rx="7" class="s-faint" stroke-width="1.2" />
            <circle cx="74" cy={y + 9} r="4" class="s-line" stroke-width="1.2" />
            <rect x="82" y={y + 6} width="22" height="3" rx="1.5" class="f-name" />
            <rect x="82" y={y + 12} width="14" height="2.5" rx="1.25" class="f-sub" />

            <g class="stats">
              {/* curtida */}
              <g transform={`translate(71 ${y + 19}) scale(0.78)`}>
                <path
                  d="M4.5 8.2C1.4 6 0 4.4 0 2.9A2.6 2.6 0 0 1 4.5 1.4 2.6 2.6 0 0 1 9 2.9c0 1.5-1.4 3.1-4.5 5.3z"
                  class="ic"
                  stroke-width="1.5"
                />
              </g>
              <text class="zero" x="80" y={y + 26} font-size="7.5">0</text>

              {/* comentário */}
              <g transform={`translate(89 ${y + 19}) scale(0.78)`}>
                <rect x="0" y="0.6" width="9" height="6.6" rx="2.2" class="ic" stroke-width="1.5" />
                <path d="M2.4 7.2v2.4l2.6-2.4" class="ic" stroke-width="1.5" stroke-linejoin="round" />
              </g>
              <text class="zero" x="98" y={y + 26} font-size="7.5">0</text>

              {/* compartilhamento */}
              <g transform={`translate(107 ${y + 19}) scale(0.78)`}>
                <circle cx="7.6" cy="1.8" r="1.5" class="ic" stroke-width="1.5" />
                <circle cx="1.5" cy="4.8" r="1.5" class="ic" stroke-width="1.5" />
                <circle cx="7.6" cy="7.8" r="1.5" class="ic" stroke-width="1.5" />
                <line x1="2.9" y1="4.1" x2="6.3" y2="2.4" class="ic" stroke-width="1.4" />
                <line x1="2.9" y1="5.5" x2="6.3" y2="7.2" class="ic" stroke-width="1.4" />
              </g>
              <text class="zero" x="116" y={y + 26} font-size="7.5">0</text>
            </g>
          </g>
        ))}
      </g>
    </svg>
  )
}
{
  name === 'roi' && (
    <svg viewBox="0 0 320 180" class="art" fill="none" aria-hidden="true">
      {/* cifrões caindo e sumindo dentro da caixa */}
      {[
        { x: 144, size: 26, d: 0 },
        { x: 134, size: 20, d: 1.6 },
        { x: 154, size: 22, d: 3.2 },
      ].map((m) => (
        <text class="money" x={m.x} y="26" text-anchor="middle" font-size={m.size} style={`--d:${m.d}s`}>
          $
        </text>
      ))}

      {/* a caixa onde o dinheiro entra */}
      <rect class="box" x="92" y="62" width="104" height="78" rx="18" stroke-width="1.8" />
      <rect x="130" y="58.5" width="28" height="7" rx="3.5" class="s-mid" stroke-width="1.5" />
      <text class="label" x="144" y="106" text-anchor="middle" font-size="10.5">ANÚNCIOS</text>

      {/* do outro lado, nenhuma resposta */}
      <line x1="206" y1="101" x2="236" y2="101" class="s-faint" stroke-width="1.5" stroke-dasharray="4 7" />
      <text class="q" x="268" y="127" text-anchor="middle" font-size="76">?</text>
    </svg>
  )
}
{
  name === 'guess' && (
    <svg viewBox="0 0 320 180" class="art" fill="none" aria-hidden="true">
      {/* indicadores sem número */}
      <g>
        <rect x="26" y="48" width="58" height="6" rx="3" fill="#fff" fill-opacity="0.16" />
        <line x1="96" y1="51" x2="116" y2="51" class="s-faint" stroke-width="4" stroke-linecap="round" />
        <rect x="26" y="86" width="48" height="6" rx="3" fill="#fff" fill-opacity="0.13" />
        <line x1="86" y1="89" x2="106" y2="89" class="s-faint" stroke-width="4" stroke-linecap="round" />
        <rect x="26" y="124" width="64" height="6" rx="3" fill="#fff" fill-opacity="0.1" />
        <line x1="102" y1="127" x2="122" y2="127" class="s-faint" stroke-width="4" stroke-linecap="round" />
      </g>
      <line x1="150" y1="34" x2="150" y2="146" class="s-faint" stroke-width="1.2" />

      {/* e a decisão saindo no chute */}
      <path d="M188 138 A 56 56 0 0 1 300 138" class="s-line" stroke-width="1.6" stroke-linecap="round" />
      <path d="M204 138 A 40 40 0 0 1 284 138" class="s-faint" stroke-width="1.3" stroke-dasharray="3 6" />
      <g class="needle">
        <line x1="244" y1="138" x2="244" y2="94" class="needle-line" stroke-width="2.4" stroke-linecap="round" />
      </g>
      <circle cx="244" cy="138" r="5" class="s-mid" stroke-width="1.6" />
      <circle cx="244" cy="138" r="1.8" fill="#f0742a" />
    </svg>
  )
}

<style>
  .art {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }

  /* traços monocromáticos + único acento */
  .s-faint { stroke: rgba(255, 255, 255, 0.12); }
  .s-line { stroke: rgba(255, 255, 255, 0.2); }
  .s-mid { stroke: rgba(255, 255, 255, 0.36); }

  /* ---- seo: pesquisa que só devolve interrogação ---- */
  .rows rect { fill: rgba(255, 255, 255, 0.17); }
  .rows .sub { fill: rgba(255, 255, 255, 0.08); }

  .typed {
    fill: rgba(255, 255, 255, 0.14);
    transform-box: fill-box;
    transform-origin: left center;
    animation: typing 6.5s steps(1, end) infinite;
  }
  @keyframes typing {
    0% { transform: scaleX(0); }
    5% { transform: scaleX(0.3); }
    9% { transform: scaleX(0.55); }
    13% { transform: scaleX(0.8); }
    17%, 100% { transform: scaleX(1); }
  }

  .caret {
    stroke: rgba(255, 255, 255, 0.32);
    animation:
      caret-move 6.5s steps(1, end) infinite,
      caret-blink 1.05s steps(1) infinite;
  }
  @keyframes caret-move {
    0% { transform: translateX(-94px); }
    5% { transform: translateX(-66px); }
    9% { transform: translateX(-42px); }
    13% { transform: translateX(-19px); }
    17%, 100% { transform: translateX(0); }
  }
  @keyframes caret-blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0.15; }
  }

  /* a lupa desce de resultado em resultado */
  .lens { animation: lens-scan 6.5s cubic-bezier(0.6, 0, 0.35, 1) infinite; }
  @keyframes lens-scan {
    0%, 20% { transform: translateY(0); }
    34%, 50% { transform: translateY(28px); }
    64%, 82% { transform: translateY(56px); }
    100% { transform: translateY(0); }
  }
  .found {
    fill: #f0742a;
    font-family: var(--font-display);
    transform-box: fill-box;
    transform-origin: center;
    animation: found-pop 6.5s ease-in-out infinite;
  }
  @keyframes found-pop {
    0%, 3% { opacity: 0; transform: scale(0.55); }
    11%, 19% { opacity: 1; transform: scale(1); }
    25%, 36% { opacity: 0; transform: scale(0.55); }
    43%, 51% { opacity: 1; transform: scale(1); }
    57%, 67% { opacity: 0; transform: scale(0.55); }
    74%, 82% { opacity: 1; transform: scale(1); }
    90%, 100% { opacity: 0; transform: scale(0.55); }
  }

  /* ---- brand: marcas iguais que não fixam na memória ---- */
  .s-you { stroke: rgba(240, 116, 42, 0.6); }
  .f-name { fill: rgba(255, 255, 255, 0.2); }
  .f-you { fill: rgba(240, 116, 42, 0.6); }

  .mark {
    transform-box: fill-box;
    transform-origin: center;
    animation: mark-fade 5.5s ease-in-out infinite;
    animation-delay: var(--d, 0s);
  }
  @keyframes mark-fade {
    0%, 22% { opacity: 1; transform: scale(1); }
    52%, 66% { opacity: 0.08; transform: scale(0.92); }
    100% { opacity: 1; transform: scale(1); }
  }

  /* ---- social: publica sem parar, engajamento zero ---- */
  .f-sub { fill: rgba(255, 255, 255, 0.1); }
  .ic { stroke: rgba(255, 255, 255, 0.3); fill: none; }
  .zero {
    fill: #f0742a;
    fill-opacity: 0.9;
    font-family: var(--font-sans);
    font-weight: 600;
  }

  .post {
    transform-box: view-box;
    animation: post-cycle 7.2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    animation-delay: var(--d, 0s);
  }
  @keyframes post-cycle {
    0% { opacity: 0; transform: translateY(32px); }
    9%, 58% { opacity: 1; transform: translateY(0); }
    70%, 100% { opacity: 0; transform: translateY(-28px); }
  }

  .stats {
    transform-box: fill-box;
    transform-origin: center;
    animation: stats-pop 7.2s ease-out infinite;
    animation-delay: calc(var(--d, 0s) + 0.4s);
  }
  @keyframes stats-pop {
    0%, 5% { opacity: 0; transform: scale(0.55); }
    12%, 56% { opacity: 1; transform: scale(1); }
    64%, 100% { opacity: 0; transform: scale(0.55); }
  }

  /* ---- roi: dinheiro entra, resposta não sai ---- */
  .money {
    fill: rgba(255, 255, 255, 0.38);
    font-family: var(--font-sans);
    font-weight: 600;
    transform-box: view-box;
    animation: money-drop 4.8s cubic-bezier(0.5, 0, 0.85, 0.45) infinite;
    animation-delay: var(--d, 0s);
  }
  @keyframes money-drop {
    0% { transform: translateY(0); opacity: 0; }
    12% { opacity: 1; }
    46% { transform: translateY(32px); opacity: 1; }
    58%, 100% { transform: translateY(42px); opacity: 0; }
  }

  /* a caixa "engole" a moeda a cada entrada */
  .box {
    stroke: rgba(255, 255, 255, 0.2);
    animation: box-swallow 1.6s ease-out 1.24s infinite;
  }
  @keyframes box-swallow {
    0%, 55% { stroke: rgba(255, 255, 255, 0.2); }
    66% { stroke: rgba(255, 255, 255, 0.44); }
    100% { stroke: rgba(255, 255, 255, 0.2); }
  }
  .label {
    fill: rgba(255, 255, 255, 0.34);
    font-family: var(--font-sans);
    font-weight: 600;
    letter-spacing: 1.6px;
  }

  .q {
    fill: #f0742a;
    font-family: var(--font-display);
    transform-box: fill-box;
    transform-origin: center;
    animation: q-appear 4.8s ease-in-out infinite;
  }
  @keyframes q-appear {
    0%, 8% { opacity: 0; transform: scale(0.86); }
    38%, 72% { opacity: 1; transform: scale(1); }
    92%, 100% { opacity: 0; transform: scale(0.86); }
  }

  /* ---- guess ---- */
  .needle {
    transform-box: view-box;
    transform-origin: 244px 138px;
    animation: needle-guess 4.8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }
  .needle-line { stroke: #f0742a; }
  @keyframes needle-guess {
    0% { transform: rotate(-56deg); }
    18% { transform: rotate(32deg); }
    34% { transform: rotate(-14deg); }
    52% { transform: rotate(54deg); }
    70% { transform: rotate(-38deg); }
    86% { transform: rotate(6deg); }
    100% { transform: rotate(-56deg); }
  }
</style>
