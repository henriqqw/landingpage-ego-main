---
// Botão flutuante de WhatsApp — o atalho que todo site profissional tem.
// É o único contato persistente da página, no desktop e no mobile.
// Aparece depois do Hero e some quando o formulário entra em cena — não faz sentido
// oferecer "fale com a gente" para quem já está preenchendo o contato.
import { waLink } from '../../content/site';
---
<a
  class="fab"
  data-wa-fab
  href={waLink('Olá! Vim pelo site da Ego Criativo e queria falar sobre o diagnóstico.')}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Falar no WhatsApp"
  data-track="cta_click"
  data-track-id="fab-whatsapp"
>
  <span class="pulso" aria-hidden="true"></span>
  <span class="rotulo">Falar no WhatsApp</span>
  <span class="glifo" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor">
      <path
        d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
      ></path>
    </svg>
  </span>
</a>

<style>
  .fab {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 45;
    display: inline-flex;
    align-items: center;
    gap: 0;
    height: 3.5rem;
    padding: 0 0.75rem;
    border-radius: 999px;
    background: #1f7d4d;
    color: #fff;
    box-shadow:
      0 10px 30px rgba(0, 0, 0, 0.45),
      0 0 0 1px rgba(255, 255, 255, 0.08) inset;
    opacity: 0;
    transform: translateY(12px) scale(0.9);
    pointer-events: none;
    transition:
      opacity 0.28s ease,
      transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1),
      background-color 0.2s ease;
  }
  /* No mobile o polegar alcança melhor um pouco mais acima da borda. */
  @media (max-width: 767px) {
    .fab {
      right: 1rem;
      bottom: calc(1rem + env(safe-area-inset-bottom));
    }
  }
  .fab.visivel {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }
  .fab:hover {
    background: #24955c;
  }

  .glifo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    flex: none;
  }

  /* O rótulo abre no hover: fechado é um ícone discreto, aberto diz o que faz. */
  .rotulo {
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    font-size: 0.875rem;
    font-weight: 600;
    opacity: 0;
    transition:
      max-width 0.32s cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 0.2s ease,
      margin 0.32s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .fab:hover .rotulo,
  .fab:focus-visible .rotulo {
    max-width: 12rem;
    margin-left: 0.5rem;
    margin-right: 0.25rem;
    opacity: 1;
  }

  /* Anel que pulsa: chama o olho sem piscar nem sacudir a interface. */
  .pulso {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: #1f7d4d;
    z-index: -1;
    animation: fab-pulso 2.6s ease-out infinite;
  }
  @keyframes fab-pulso {
    0% {
      transform: scale(1);
      opacity: 0.55;
    }
    70%,
    100% {
      transform: scale(1.5);
      opacity: 0;
    }
  }
  .fab:hover .pulso {
    animation-play-state: paused;
  }
</style>

<script>
  const fab = document.querySelector<HTMLElement>('[data-wa-fab]');
  const hero = document.getElementById('top');
  const contato = document.getElementById('contato');

  if (fab && hero) {
    let heroVisivel = true;
    let formVisivel = false;

    const aplicar = () => {
      const mostrar = !heroVisivel && !formVisivel;
      fab.classList.toggle('visivel', mostrar);
      // Escondido não pode ser alcançável por teclado.
      fab.tabIndex = mostrar ? 0 : -1;
      fab.setAttribute('aria-hidden', String(!mostrar));
    };

    new IntersectionObserver(
      ([e]) => {
        heroVisivel = e.isIntersecting;
        aplicar();
      },
      { threshold: 0 }
    ).observe(hero);

    if (contato) {
      new IntersectionObserver(
        ([e]) => {
          formVisivel = e.isIntersecting;
          aplicar();
        },
        { threshold: 0.2 }
      ).observe(contato);
    }

    aplicar();
  }
</script>
