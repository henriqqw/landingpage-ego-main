---
// Processo é sequência, não grade: os quatro passos descem alternando o lado,
// com o numeral vazado gigante atrás do título — a escala que faltava na página.
import Container from '../ui/Container.astro';
import MethodArt from '../ui/MethodArt.astro';
import { method } from '../../content/copy';
---
<section id="metodo" class="secao" data-section="metodo">
  <Container>
    <div class="cabeca">
      <p class="reveal eyebrow mono-label">Método</p>
      {/* {' '} explícito: o Astro remove a quebra de linha entre o texto e o span,
          e sem isso o travessão cola na palavra anterior. */}
      <h2 class="reveal titulo">
        Você vai saber exatamente o que recebe{' '}
        <span class="destaque">— e quando pode cobrar</span>
      </h2>
      <p class="reveal sub">
        Nenhuma etapa aqui termina em “vamos alinhando”. Cada uma termina num documento.
      </p>
    </div>

    <ol class="passos">
      {
        method.map((m, i) => (
          <li class="passo reveal" style={`--reveal-delay:${i * 60}ms`}>
            <div class="texto">
              <span class="num" aria-hidden="true">
                {m.step}
              </span>
              <h3 class="titulo">
                <span class="num-sr sr-only">Passo {m.step}.</span>
                {m.title}
              </h3>
              <p class="desc">{m.desc}</p>
              <p class="entrega">
                <span class="mono-label">Você recebe</span>
                {m.entrega}
              </p>
            </div>
            <div class="arte">
              <MethodArt name={m.art} />
            </div>
          </li>
        ))
      }
    </ol>
  </Container>
</section>

<style>
  /* Superfície clara — a mesma do Bridge e do CTA final. */
  .secao {
    background: linear-gradient(180deg, #f6f1ea 0%, #ece4d9 100%);
    color: #1a120c;
    padding-block: clamp(4rem, 10vw, 8rem);
    /* Tinta das ilustrações: a arte é a mesma, só troca a cor do traço — e a
       opacidade sobe, porque tinta escura no creme separa menos que branca no preto. */
    --art-ink: 26, 18, 12;
    --art-acento: #c25a15;
    --art-contraste: 1.9;
  }

  .cabeca {
    max-width: 760px;
    margin-inline: auto;
    text-align: center;
  }
  .eyebrow {
    color: #a84a12;
  }
  .titulo {
    margin-top: 1rem;
    font-size: clamp(2rem, 4.6vw, 3.3rem);
    line-height: 1.08;
    color: #160f0a;
  }
  .destaque {
    background: linear-gradient(90deg, #a84a12, #e0761f);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .sub {
    margin-top: 1.25rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: #5c4d42;
  }

  .passos {
    list-style: none;
    margin: 4rem 0 0;
    padding: 0;
    display: grid;
    gap: 3.5rem;
  }
  .passo {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 860px) {
    .passos {
      gap: 4.5rem;
    }
    .passo {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
    /* alterna o lado: a sequência ganha ritmo próprio, sem virar grade de cards */
    .passo:nth-child(even) .texto {
      order: 2;
    }
  }
  .passo + .passo {
    padding-top: 3.5rem;
    border-top: 1px solid rgba(26, 18, 12, 0.12);
  }

  .texto {
    position: relative;
  }
  /* numeral vazado atrás do título */
  .num {
    position: absolute;
    top: -0.35em;
    left: -0.06em;
    z-index: -1;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 9vw, 7rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(26, 18, 12, 0.18);
  }
  .passo .titulo {
    margin-top: 0;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.2vw, 2.25rem);
    line-height: 1.15;
    color: #160f0a;
  }
  .desc {
    margin-top: 0.875rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: #5c4d42;
  }
  .entrega {
    margin-top: 1.25rem;
    padding-left: 1.125rem;
    border-left: 2px solid rgba(194, 90, 21, 0.55);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: #3d3129;
  }
  .entrega .mono-label {
    display: block;
    margin-bottom: 0.375rem;
    color: #a84a12;
  }

  .arte {
    max-width: 420px;
    width: 100%;
  }
  @media (min-width: 860px) {
    .arte {
      justify-self: center;
    }
  }
</style>
