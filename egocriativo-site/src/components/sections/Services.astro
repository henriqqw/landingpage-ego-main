---
// Sete cards iguais são sete vezes a mesma informação visual, e transferem a decisão
// para o visitante. Um índice numerado lê como sumário — e sumário lê como substância.
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { services, tools } from '../../content/services';
---
<section id="servicos" class="py-[clamp(4rem,10vw,8rem)]" data-section="servicos">
  <Container>
    <SectionHeading
      eyebrow="Soluções"
      title='Tudo o que sua marca precisa, <span class="text-gradient">em um só lugar</span>'
      subtitle="Estratégia, criação, tecnologia e eventos sob o mesmo teto — cada frente com lastro na atividade registrada do nosso CNPJ."
      align="left"
      class="mx-0"
    />

    <ol class="indice">
      {
        services.map((s, i) => (
          <li class="linha reveal" style={`--reveal-delay:${i * 45}ms`}>
            <span class="n mono-label tabnum">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="titulo">{s.title}</h3>
            <p class="desc">{s.desc}</p>
            <span class="mais" aria-hidden="true">+</span>
          </li>
        ))
      }
    </ol>

    <div class="stack reveal">
      <span class="mono-label">Stack</span>
      <p class="ferramentas mono-label">{tools.join(' · ')}</p>
    </div>
  </Container>
</section>

<style>
  .indice {
    list-style: none;
    margin: 3.5rem 0 0;
    padding: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.09);
  }
  .linha {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    align-items: start;
    gap: 0.375rem 1rem;
    padding: 1.5rem 1rem 1.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
    transition: background-color 0.16s ease;
  }
  @media (min-width: 900px) {
    .linha {
      grid-template-columns: 3.5rem minmax(0, 1fr) minmax(0, 1fr) 2rem;
      align-items: center;
      gap: 1.5rem;
      padding-block: 1.75rem;
    }
  }
  .linha:hover {
    background: rgba(255, 255, 255, 0.03);
  }

  .n {
    padding-top: 0.45rem;
    transition: color 0.16s ease;
  }
  .linha:hover .n {
    color: var(--color-orange);
  }

  .titulo {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.6vw, 2.125rem);
    line-height: 1.15;
    color: var(--color-ink);
    transition: transform 0.16s ease;
  }
  .linha:hover .titulo {
    transform: translateX(6px);
  }

  .desc {
    grid-column: 2;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-muted);
  }
  @media (min-width: 900px) {
    .desc {
      grid-column: auto;
    }
  }

  .mais {
    display: none;
    font-family: var(--font-mono);
    font-size: 1.25rem;
    color: var(--color-dim);
    text-align: right;
    transition: color 0.16s ease, transform 0.16s ease;
  }
  @media (min-width: 900px) {
    .mais {
      display: block;
    }
  }
  .linha:hover .mais {
    color: var(--color-orange);
    transform: rotate(90deg);
  }

  /* Ferramenta em filete, não em pílula: o registro documental de novo. */
  .stack {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 1.25rem;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.09);
  }
  .stack > .mono-label {
    color: var(--color-amber);
  }
  .ferramentas {
    color: var(--color-muted);
    text-transform: none;
    letter-spacing: 0.04em;
    font-size: 0.75rem;
  }
</style>
